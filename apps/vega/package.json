{
  "name": "@martie/vega",
  "version": "2.2.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "clean": "rm -rf build bundle dist generated kepler-build",
    "start": "react-native start",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm run build:release",
    "run:vvd": "vega run-app build/aarch64-release/vega_aarch64.vpkg dev.hyo.martie.main -d VirtualDevice",
    "run:firetv": "vega run-app build/armv7-release/vega_armv7.vpkg dev.hyo.martie.main -d"
  },
  "dependencies": {
    "@amazon-devices/kepler-module-resolver-preset": "^0.1.15",
    "@amazon-devices/react-native-kepler": "^2.0.0",
    "@amazon-devices/webview": "~3.5.7",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "~0.22.0",
    "@amazon-devices/kepler-compatibility-metro-config": "^0.0.7",
    "@react-native-community/cli": "^11.4.1",
    "@react-native/eslint-config": "0.72.2",
    "@react-native/metro-config": "^0.72.6",
    "@types/node": "^18.19.130",
    "@types/react": "^18.2.75",
    "babel-plugin-module-resolver": "^5.0.2",
    "metro-react-native-babel-preset": "~0.76.9",
    "typescript": "~4.9.5"
  },
  "kepler": {
    "projectType": "application",
    "appName": "MartieVega",
    "targets": [
      "tv"
    ],
    "os": [
      "vega"
    ],
    "api": 0.1
  }
}
