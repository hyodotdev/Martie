# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

EXPO_PUBLIC_CONVEX_URL=
# Optional payment return URL; derived from EXPO_PUBLIC_CONVEX_URL when omitted.
EXPO_PUBLIC_CONVEX_SITE_URL=

# Unity LevelPlay app keys and ad unit IDs are in src/utils/levelPlayConfig.ts.
# Unity Ads account API secrets are dashboard credentials, not app env values.

# iap_only | mock_pg | toss_test | naver_test | alternative_billing
EXPO_PUBLIC_PAYMENT_MODE=iap_only
# Toss Payments client key for toss_test / alternative_billing builds.
# Test keys start with test_ck_. Secret key (test_sk_ / live_sk_) is set as
# TOSS_SECRET_KEY in Convex env, never in the client.
EXPO_PUBLIC_TOSS_CLIENT_KEY=
# Naver Pay 결제형 keys for naver_test / alternative_billing builds.
# Client ID + Chain ID are public. Client Secret is set as
# NAVER_PAY_CLIENT_SECRET in Convex env, never in the client.
EXPO_PUBLIC_NAVER_PAY_CLIENT_ID=
EXPO_PUBLIC_NAVER_PAY_CHAIN_ID=
# development (sandbox) | production
EXPO_PUBLIC_NAVER_PAY_MODE=development

# Required for `HORIZON_OS=1` builds. This is the Meta Horizon app ID
# injected into AndroidManifest.xml for Quest/Horizon IAP.
# HORIZON_APP_ID is also supported as a legacy fallback.
META_HORIZON_APP_ID=

# Convex server only: enable Apple Sandbox receipts on the test deployment.
# APPLE_IAP_ALLOW_SANDBOX=true
